# ==============================================================================
# FileTools 环境变量清单
# ==============================================================================
# ⚠️ 请先读这一段，否则这个文件会误导你：
#
#   1. 后端**不会**自动读取 .env 文件。backend/config.py 用的是
#      os.environ.get()，项目里没有 python-dotenv，也没有任何 .env 加载代码。
#      把本文件复制成 .env 放在仓库根目录，**对程序没有任何影响**。
#
#   2. 这些变量要通过真正的方式注入：
#        Linux/macOS   export FILETOOLS_XXX=值    （或写进 systemd 的 Environment=）
#        Windows       set FILETOOLS_XXX=值       （或写进「系统属性 → 环境变量」）
#        Docker        docker run -e FILETOOLS_XXX=值 ...
#
#   3. 所以本文件是**一张清单**，不是一份被加载的配置。它的用途是让你看到
#      有哪些旋钮、默认值是多少，然后只把需要改的那几个注入进去。
#
#   4. 下面每一行写的就是**程序内置的默认值**。全部照抄等于什么都没改。
#
# 改完想确认生效了没有：前端页面上的限制值全部来自 GET /api/config，
# 刷新页面即可看到新值，不需要重新构建前端。
# 完整说明见 README「配置项」。
# ==============================================================================


# ------------------------------------------------------------------------------
# 上传与批量
# ------------------------------------------------------------------------------
# 单文件上传上限（字节）。默认 50 MB
FILETOOLS_MAX_UPLOAD_BYTES=52428800
# 单次批量请求最多处理多少个文件
FILETOOLS_MAX_BATCH_FILES=50
# 单次批量请求所有文件加起来的上限（字节）。默认 300 MB
FILETOOLS_MAX_BATCH_TOTAL_BYTES=314572800
# 整批处理超时（秒）
FILETOOLS_BATCH_TIMEOUT=300
# 单个文件处理超时（秒）
FILETOOLS_PROCESS_TIMEOUT=60


# ------------------------------------------------------------------------------
# 图片
# ------------------------------------------------------------------------------
# 解码后最大像素数（防图片炸弹）
FILETOOLS_MAX_IMAGE_PIXELS=80000000
# 图片最长边上限（像素）
FILETOOLS_MAX_IMAGE_EDGE=12000
# 未指定质量时使用的默认质量（无损格式不受影响）
FILETOOLS_DEFAULT_QUALITY=85
# 单个 SVG 的最大字节数。默认 2 MB
FILETOOLS_MAX_SVG_BYTES=2097152
# SVG 的最大节点数
FILETOOLS_MAX_SVG_NODES=20000


# ------------------------------------------------------------------------------
# Worker 池与任务队列
# ------------------------------------------------------------------------------
# 全局线程池大小（CPU 密集任务的并发上限）
FILETOOLS_MAX_WORKERS=5
# 各池并发。把 OFFICE_WORKERS / OCR_WORKERS 调大不会提升吞吐：
# 这两条路径各有一把串行锁，多开的 worker 只会堵在锁上
FILETOOLS_IMAGE_WORKERS=2
FILETOOLS_PDF_WORKERS=1
FILETOOLS_OFFICE_WORKERS=1
FILETOOLS_OCR_WORKERS=1
FILETOOLS_QUEUE_WORKERS=2
# 各池兜底超时（秒）。**生效值 = max(池兜底, 池内操作的超时)**，兜底是下限不是旋钮
FILETOOLS_IMAGE_TIMEOUT=120
FILETOOLS_PDF_TIMEOUT=180
# Office 池兜底 120 秒，但 Office 转换本身是 180 秒，所以生效值是 180
FILETOOLS_OFFICE_POOL_TIMEOUT=120
FILETOOLS_DEFAULT_ITEM_TIMEOUT=120
# 超时任务是否自动重试（默认关）。只认 1/true/yes/on 为真
FILETOOLS_TASK_TIMEOUT_AUTO_RETRY=0
# 自动重试次数上限
FILETOOLS_TASK_MAX_AUTO_RETRIES=1
# 看门狗扫描间隔（秒）
FILETOOLS_WORKER_WATCHDOG_INTERVAL=5
# 判定 worker 丢失的宽限（秒）
FILETOOLS_WORKER_LOST_GRACE=30
# 优先级老化：等多久提升一档（秒）
FILETOOLS_PRIORITY_AGING_SECONDS=60
# 优先级最多提升几档
FILETOOLS_PRIORITY_AGING_STEPS=2
# 优雅关机的等待秒数（空载时零等待）
FILETOOLS_SHUTDOWN_GRACE=10


# ------------------------------------------------------------------------------
# 临时文件与生命周期
# ------------------------------------------------------------------------------
# 结果文件保留时长（秒）。默认 30 分钟
FILETOOLS_JOB_TTL=1800
# 任务记录保留时长（秒），过期后查询返回 404。默认 30 分钟
FILETOOLS_TASK_TTL=1800
# 定时清理的扫描间隔（秒）
FILETOOLS_CLEANUP_INTERVAL=60
# 临时文件根目录。留空 = 用系统临时目录
FILETOOLS_TEMP_ROOT=
# 允许跨域的前端地址，逗号分隔
FILETOOLS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 是否注册 /api/system/*（默认开）。只认 1/true/yes/on 为真
FILETOOLS_SYSTEM_API=1


# ------------------------------------------------------------------------------
# PDF
# ------------------------------------------------------------------------------
# 单个 PDF 最多处理多少页
FILETOOLS_MAX_PDF_PAGES=500
# 上传的 PDF 保留时长（秒）
FILETOOLS_PDF_INPUT_TTL=1800
# 页面缩略图最多渲染多少页
FILETOOLS_PDF_THUMBNAIL_MAX_PAGES=60
# 缩略图宽度（像素）
FILETOOLS_PDF_THUMBNAIL_WIDTH=220
# PDF 渲染 DPI 上限
FILETOOLS_PDF_RENDER_MAX_DPI=300
# 单页渲染的最大像素数
FILETOOLS_PDF_RENDER_MAX_PIXELS=40000000
# 一次最多把多少页导出成图片
FILETOOLS_PDF_EXPORT_MAX_PAGES=100


# ------------------------------------------------------------------------------
# 文档转换与 PDF → Word
# ------------------------------------------------------------------------------
# LibreOffice 启动器路径，**可指文件也可指目录**。留空 = 自动探测。
# 显式配置了却不存在时，服务会判定为「缺少组件」并如实提示，不会改用自动找到的另一个
FILETOOLS_LIBREOFFICE_PATH=
# 单次 Office 转换的超时（秒）
FILETOOLS_OFFICE_TIMEOUT=180
# 等转换锁的上限（秒），超时报「服务器正忙」
FILETOOLS_OFFICE_LOCK_WAIT=60
# TXT 默认字号
FILETOOLS_TXT_FONT_SIZE=11
# TXT 排版的超时（秒）
FILETOOLS_TXT_TIMEOUT=120
# 单个 TXT 最多多少字符
FILETOOLS_MAX_TXT_CHARS=500000
# 一份 TXT 最多排多少页
FILETOOLS_MAX_TXT_PAGES=500
# PDF→Word 超时（秒）
FILETOOLS_PDF_TO_WORD_TIMEOUT=300
# 少于这个字符数就判定为扫描页、走 OCR
FILETOOLS_PDF_TO_WORD_MIN_CHARS=16
# 最多 OCR 多少页（OCR 是逐页串行的，约 2 秒/页）
FILETOOLS_PDF_TO_WORD_MAX_OCR_PAGES=30
# OCR 渲染 DPI
FILETOOLS_PDF_TO_WORD_OCR_DPI=200
# OCR 效果不佳时的重试 DPI
FILETOOLS_PDF_TO_WORD_OCR_RETRY_DPI=300
# 等 OCR 锁的上限（秒）
FILETOOLS_PDF_TO_WORD_OCR_LOCK_WAIT=60
# 写进 DOCX 的中文字体名。**这是给阅读器的提示，不是保证**
FILETOOLS_PDF_TO_WORD_FONT=宋体
# 图片型页面嵌入 DOCX 时的 DPI
FILETOOLS_PDF_TO_WORD_EMBED_DPI=150
# 嵌入图片的 JPEG 质量
FILETOOLS_PDF_TO_WORD_EMBED_QUALITY=80
# 嵌入图片总量上限（字节）。用完就不再嵌图，并如实说明「部分页面只保留了文字」。
# 默认 60 MB
FILETOOLS_PDF_TO_WORD_MAX_EMBED_BYTES=62914560
# 整个 PDF→Word 任务的算力预算（秒），**必须小于外层超时**
FILETOOLS_PDF_TO_WORD_WORKER_BUDGET=270
# 设为 1 可整个关掉 OCR，此时扫描件会如实提示需要 OCR 组件，而不是给一份空文档
FILETOOLS_OCR_DISABLED=0
# OCR 超时（秒）
FILETOOLS_OCR_TIMEOUT=300


# ------------------------------------------------------------------------------
# Markup（HTML / Markdown）
# ------------------------------------------------------------------------------
# 单个标记文档最多多少字符
FILETOOLS_MAX_MARKUP_CHARS=500000
# 最大节点数
FILETOOLS_MAX_MARKUP_NODES=20000
# 最多允许多少张内联图片
FILETOOLS_MAX_MARKUP_IMAGES=50
# 单张内联图片上限（字节）。默认 256 KB
FILETOOLS_MAX_MARKUP_IMAGE_BYTES=262144
# Markup 转换超时（秒）
FILETOOLS_MARKUP_TIMEOUT=120


# ==============================================================================
# 前端（两个变量，机制和后端不一样）
# ==============================================================================
# 这两个**不是**后端变量，别写进上面那套注入里：
#
#   VITE_API_BASE_URL  —— 前端代码通过 import.meta.env 读取。Vite 会自动加载
#                         `frontend/.env`（不是仓库根目录的 .env），
#                         所以要生效得写进 frontend/.env。留空 = 用相对路径
#                         （前后端同源部署时的正确选择）。
#   VITE_BACKEND_URL   —— 只给 `npm run dev` 的代理用，由 vite.config.ts 从
#                         Node 进程环境读取，构建产物里不含它。
#
# VITE_API_BASE_URL=
# VITE_BACKEND_URL=http://127.0.0.1:8000
